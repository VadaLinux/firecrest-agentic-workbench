# Copy to demo/.env (gitignored) and fill in locally. No secrets belong in git.
# Public hostname of the MCP endpoint behind Cloudflare, e.g. https://mcp.example.org
DEMO_PUBLIC_URL=
# Primary model is OMNIROUTE_MODEL (see firecrest-mcp/.env.example). Fallback used by `run-demo.sh check`:
DEMO_FALLBACK_MODEL=
# Seconds between lines in demo/replay.sh
DEMO_REPLAY_DELAY=1
