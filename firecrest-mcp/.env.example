# FirecREST connection for firecrest-mcp
#
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# `.env` is gitignored. Never commit real credentials, tokens or client
# secrets — see AGENTS.md.

# Base URL of the FirecREST gateway (Kong in the demo stack). No trailing slash.
FIRECREST_BASE_URL=http://localhost:8000

# Token endpoint for the OAuth2 client-credentials flow.
# This is set separately because the token issuer lives on a different host and
# port from the gateway (Keycloak :8080 vs Kong :8000 in the demo) and cannot be
# derived from FIRECREST_BASE_URL.
FIRECREST_TOKEN_URL=http://localhost:8080/auth/realms/kcrealm/protocol/openid-connect/token

# Client credentials. In the demo stack these come from
# firecrest/deploy/demo/demo_client/client_secrets.json.
FIRECREST_CLIENT_ID=firecrest-sample
FIRECREST_CLIENT_SECRET=replace-me

# System to target when a tool call does not name one. The demo exposes "cluster".
FIRECREST_SYSTEM=cluster

# --- Optional -------------------------------------------------------------

# Per-request timeout in seconds (default 30).
FIRECREST_TIMEOUT=30

# Where get_job_log writes job output, and where submission records are kept so
# a job id can be mapped back to its output paths. Gitignored.
FIRECREST_LOG_DIR=logs

# Set to false only for a stack with a self-signed certificate you trust.
FIRECREST_VERIFY_SSL=true

# --- FirecREST v2 (optional, selectable transport) -------------------------
#
# Set FIRECREST_API_VERSION=v2 to make server.py talk FirecREST v2
# (firecrest-mcp/client_v2.py) instead of v1's client.py above. Unset, or
# "v1", keeps today's default untouched. See docs/hot-cache-v2.md for what
# v2 changed vs v1, and docs/reports/05-firecrest-v2-gap.md for why this is a
# second client rather than a rewrite of the one above.
FIRECREST_API_VERSION=v1

# v2 gateway base URL. No trailing slash. (v2 demo: http://localhost:5025)
FIRECREST_V2_BASE_URL=http://localhost:5025

# v2's token issuer. Same two-port split as v1's Keycloak-vs-Kong above, for
# unrelated reasons on each side — see docs/hot-cache-v2.md §1.
# (v2 demo launcher: http://localhost:8025/token)
FIRECREST_V2_TOKEN_URL=http://localhost:8025/token

# Client credentials for the v2 token endpoint. The v2 demo launcher does not
# check client_secret at all (any value works); do not assume that holds
# anywhere real.
FIRECREST_V2_CLIENT_ID=demo
FIRECREST_V2_CLIENT_SECRET=replace-me

# v2 addresses the system as a URL path segment, not a header — this is that
# system name. Independent of FIRECREST_SYSTEM above; there is no shared
# default between the two versions. (v2 demo's stand-in cluster: fakecluster)
FIRECREST_V2_SYSTEM=fakecluster

# --- Optional ---------------------------------------------------------------

FIRECREST_V2_TIMEOUT=30
FIRECREST_V2_LOG_DIR=logs
FIRECREST_V2_VERIFY_SSL=true
