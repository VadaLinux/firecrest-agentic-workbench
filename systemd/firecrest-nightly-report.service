[Unit]
Description=Deterministic nightly report for DocMind re-ingestion (VDLP-19)
Documentation=file:///home/gavadala/Sviluppo/firecrest-agentic-workbench/scripts/nightly_report.sh
# Replaces the "nightly report — {{date}}" autopilot (32456996-5afc-446f-87e4-88e722b00294).
# No LLM in this path: scripts/nightly_report.sh derives its own target night from
# the last "nightly report — DATE" issue it filed (so a skipped morning is recovered,
# not lost), reads the host log/result file and the container's live snapshot pointer
# every run, and reports both when they diverge. See the script's own header comment.
Requires=firecrest-workbench-deploy.service
After=firecrest-workbench-stacks.service firecrest-workbench-deploy.service firecrest-reingest.service

[Service]
Type=oneshot
WorkingDirectory=%h/Sviluppo/firecrest-agentic-workbench
ExecStart=/bin/bash %h/Sviluppo/firecrest-agentic-workbench/scripts/nightly_report.sh

TimeoutStartSec=10min
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=firecrest-nightly-report

[Install]
WantedBy=default.target
